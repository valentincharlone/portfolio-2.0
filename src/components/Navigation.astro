---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-10 h-12 border-b border-transparent transition-all duration-300"
>
  <a href="#" class="text-[13px] font-medium tracking-wide text-text-primary">
    VC<span class="text-accent">.</span>
  </a>

  <div
    class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[11px] uppercase tracking-[0.06em] text-text-muted hover:text-text-primary transition-colors duration-150"
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <a
    href="#contact"
    class="hidden md:flex items-center gap-1.5 text-[12px] tracking-wide text-text-secondary hover:text-accent transition-colors duration-150 group"
    href="#contact"
    class="hidden md:flex items-center gap-1.5 text-[12px] tracking-wide text-text-secondary hover:text-accent transition-colors duration-150 group"
  >
    Get in Touch
    <span
      class="w-3.5 h-3.5 rounded-full border border-border group-hover:border-accent flex items-center justify-center text-[9px] transition-colors duration-150"
    >
      ↗
    </span>
  </a>

  <button
    id="mobile-menu-button"
    class="md:hidden p-2 text-text-muted hover:text-text-primary transition-colors"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</nav>

<div
  id="mobile-menu"
  class="hidden fixed top-12 left-0 right-0 z-40 bg-background/95 backdrop-blur-sm border-b border-border/40 px-10 py-6 space-y-4"
>
  {
    navLinks.map((link) => (
      <a
        href={link.href}
        class="block text-[11px] uppercase tracking-[0.06em] text-text-muted hover:text-text-primary transition-colors duration-150"
      >
        {link.label}
      </a>
    ))
  }
  <a
    href="#contact"
    class="block text-[11px] uppercase tracking-[0.06em] text-accent pt-3 border-t border-border/40"
  >
    Get in Touch ↗
  </a>
</div>

<script>
  const nav = document.getElementById("main-nav");
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      nav?.classList.add(
        "bg-background/80",
        "backdrop-blur-xl",
        "border-border/40",
      );
      nav?.classList.remove("border-transparent");
    } else {
      nav?.classList.remove(
        "bg-background/80",
        "backdrop-blur-xl",
        "border-border/40",
      );
      nav?.classList.add("border-transparent");
    }
  });

  button?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu
    ?.querySelectorAll("a")
    .forEach((link) =>
      link.addEventListener("click", () => menu?.classList.add("hidden")),
    );
</script>
