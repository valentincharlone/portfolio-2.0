---
import { experiences } from "@/lib/data";
---

<section id="experience" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Left-aligned header -->
    <div class="mb-16">
      <p class="text-accent font-mono text-sm mb-3">// experience</p>
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary">Where I've worked</h2>
    </div>
    
    <div class="relative pl-8">
      <!-- Timeline line -->
      <div class="absolute left-[5px] top-2 bottom-0 w-px bg-border"></div>
      
      <div class="space-y-14">
        {experiences?.map((exp) => (
          <div class="relative">
            <!-- Timeline dot -->
            <div class="absolute -left-8 top-1.5 flex items-center justify-center">
              <div class="w-[11px] h-[11px] bg-surface border-2 border-text-muted rounded-full relative">
                {exp.current && (
                  <span class="absolute inset-0 rounded-full bg-accent/50 animate-ping"></span>
                )}
                {exp.current && (
                  <div class="absolute inset-0 rounded-full border-2 border-accent bg-surface"></div>
                )}
              </div>
            </div>
            
            <!-- Content -->
            <div>
              <span class="inline-block text-text-muted font-mono text-sm mb-3">{exp.period}</span>
              <h3 class="text-xl font-semibold text-text-primary mb-4">
                {exp.role} <span class="text-accent">@ {exp.company}</span>
              </h3>
              
              <ul class="space-y-3">
                {exp?.description?.map(item => (
                  <li class="text-sm text-text-muted flex items-start gap-3">
                    <span class="text-accent mt-[7px] flex-shrink-0">
                      <svg class="w-[6px] h-[6px]" fill="currentColor" viewBox="0 0 6 6">
                        <polygon points="0,0 6,3 0,6"/>
                      </svg>
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
