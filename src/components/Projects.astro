---
import { projects } from "@/lib/data";
import { Icon } from "astro-icon/components";
---

<section id="projects" class="py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-accent font-mono text-sm mb-4">My work</p>
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        Featured Projects
      </h2>
      <p class="text-text-muted max-w-2xl mx-auto">
        A selection of projects that showcase my skills and passion for building
        great software
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        projects.map((project, index) => (
          <article class="group relative bg-surface border border-border rounded-sm p-6 md:p-8 hover:border-accent/30 transition-all duration-300 hover:shadow-xl hover:shadow-accent/5">
            <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl" />

            <div class="relative">
              {/* {project.featured && (
                <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium text-accent bg-accent/10 rounded-full mb-4">
                  Featured
                </span>
              )} */}

              <h3 class="text-xl tracking-wider font-semibold text-text-primary mb-3 group-hover:text-accent transition-colors duration-300">
                {project.title}
              </h3>

              <p class="text-text-muted text-sm leading-relaxed mb-6">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-6">
                {project.tech.map((tech) => (
                  <span class="px-3 py-1 text-xs font-mono text-text-secondary bg-background rounded-full border border-border">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <Icon
                    name="simple-icons:github"
                    class="w-5 h-5 mr-2 text-zinc-400 group-hover:text-text-primary transition-colors duration-300"
                  />
                  Code
                </a>
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
                  aria-label={`View ${project.title} live demo`}
                >
                  <Icon
                    name="heroicons:link"
                    class="w-5 h-5 mr-2 text-zinc-400 group-hover:text-text-primary transition-colors duration-300"
                  />
                  Live Demo
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="text-center mt-12">
      <a
        href="https://github.com/valentincharlone"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-3 text-sm font-medium text-text-secondary border border-border rounded-sm hover:text-text-primary hover:border-text-muted transition-all duration-200"
      >
        View All Projects
        <svg
          class="ml-2 w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
