---
import { Image } from "astro:assets";
import profilImage from "../../public/vachi.jpg";
import { Icon } from "astro-icon/components";
import { socialLinks } from "@/lib/data";
---

<section
  id="about"
  class="relative w-full min-h-screen flex items-center justify-center pt-16"
>
  <div class="relative max-w-4xl mx-auto px-6 text-center mt-10">
    <Image
      src={profilImage}
      alt="Valentin Charlone"
      class="w-24 h-24 object-cover rounded-md mx-auto mb-6 opacity-0 animate-fade-in-up animation-delay-100 transition-all duration-300"
    />
    <div class="opacity-0 animate-fade-in-up">
      <p class="text-accent font-mono text-sm mb-4">Hello, I'm</p>
    </div>

    <h1
      class="text-5xl font-bold text-text-primary mb-6 opacity-0 animate-fade-in-up animation-delay-100"
    >
      Valentin Charlone
    </h1>

    <h2
      class="text-2xl  font-semibold text-text-secondary mb-6 opacity-0 animate-fade-in-up animation-delay-200"
    >
      Frontend Engineer - IA Enthusiast
    </h2>

    <p
      class="text-lg text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed opacity-0 animate-fade-in-up animation-delay-300"
    >
      Specialized in React, Next.js, TypeScript, and modern UI systems.
      Experienced in building complex dashboards, scalable component
      architectures, and high-performance web applications with a strong focus
      on product quality and user experience.
    </p>

    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4 opacity-0 animate-fade-in-up animation-delay-400"
    >
      <a
        href="#projects"
        class="inline-flex items-center px-6 py-3 text-sm font-medium text-background bg-text-primary rounded-sm hover:bg-text-primary/90 transition-all duration-200 hover:shadow-lg hover:shadow-white/10"
      >
        View Projects
        <Icon
          name="lucide:arrow-down"
          class="w-4 h-4 ml-2 text-background group-hover:text-white transition-colors duration-200"
        />
      </a>
      <a
        href="#contact"
        class="inline-flex items-center px-6 py-3 text-sm font-medium text-text-primary border border-border rounded-sm hover:bg-surface hover:border-text-muted transition-all duration-200"
      >
        Contact Me
        <Icon
          name="lucide:arrow-right"
          class="w-4 h-4 ml-2 text-white transition-colors duration-200"
        />
      </a>
    </div>
    <div
      class="flex items-center justify-center gap-6 opacity-0 animate-fade-in-up animation-delay-500"
    >
      {
        socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-text-muted hover:text-accent transition-colors duration-200"
            aria-label={social.name}
          >
            <Icon name={social.icon} size={social.size} />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Scroll indicator -->
  <!-- <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in-up animation-delay-400"
  >
    <div
      class="w-6 h-10 rounded-full border-2 border-border items-start justify-center p-1 pt-2 hidden md:flex"
    >
      <div class="w-1.5 h-3 bg-text-muted rounded-full animate-bounce"></div>
    </div>
  </div> -->
</section>
