---
import Analytics from '@vercel/analytics/astro'
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Frontend Engineer specialized in React, Next.js, TypeScript, and modern UI systems. Building scalable, high-performance web applications.",
} = Astro.props;

const siteUrl = "https://vachi-portfolio.vercel.app";
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Open Graph / LinkedIn / Social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Valentin Charlone Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Analytics />
    <slot />
    <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js" is:inline
    ></script>
    <script is:inline>
      const lenis = new Lenis({
        lerp: 0.08, // 👈 CLAVE (esto es lo que usa la mayoría de sitios pro)
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 1,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
