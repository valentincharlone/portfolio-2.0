---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Frontend Engineer specialized in React, Next.js, TypeScript, and modern UI systems. Building scalable, high-performance web applications.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js" is:inline
    ></script>
    <script is:inline>
      const lenis = new Lenis({
        lerp: 0.08, // 👈 CLAVE (esto es lo que usa la mayoría de sitios pro)
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 1,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
